<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docxodus" Version="12.4.1" />
  </ItemGroup>

  <!-- The SDK otherwise includes the nested test project's sources and assets. -->
  <ItemGroup>
    <Compile Remove="DocxodusService.Tests/**" />
    <Content Remove="DocxodusService.Tests/**" />
    <None Remove="DocxodusService.Tests/**" />
  </ItemGroup>

</Project>
